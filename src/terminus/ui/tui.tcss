/* TERMINUS TUI Premium Stylesheet */

Screen {
    background: #0d0d0d;
    color: #ffffff;
}

#app_layout {
    width: 100%;
    height: 100%;
}

/* Sidebar Pane */
#sidebar_pane {
    width: 30;
    height: 100%;
    background: #121212;
    border-right: solid #262626;
    padding: 1 2;
}

#sidebar_pane.-hidden {
    display: none;
}

#sidebar_title {
    color: #ffffff;
    text-align: left;
    height: 3;
    content-align: left middle;
    text-style: bold;
    padding-left: 1;
}

.section_header {
    color: #888888;
    text-style: bold;
    padding-top: 1;
    padding-bottom: 0;
    margin-bottom: 0;
}

.chats_header_row {
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

.chats_header_row > Label {
    width: 1fr;
}

.chats_header_row Button {
    min-width: 3;
    height: 1;
    background: transparent;
    color: #888888;
    border: none;
    padding: 0;
    margin: 0;
}

.chats_header_row Button:hover {
    color: #ffb86c;
    text-style: bold;
}

#tags_tree {
    background: transparent;
    color: #cccccc;
    height: 12;
    border: none;
    padding: 0;
}

#chats_list {
    background: transparent;
    color: #cccccc;
    height: 1fr;
    border: none;
    padding: 0;
}

/* System Pane */
#sidebar_system_pane {
    background: #1a1a1a;
    border: solid #262626;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
    height: 7;
}

.sys_info_lbl {
    color: #cccccc;
    height: 1;
    content-align: left middle;
}

#sidebar_footer {
    height: 3;
    layout: horizontal;
    border-top: solid #262626;
    padding-top: 1;
}

#username_lbl {
    width: 1fr;
    color: #888888;
    content-align: left middle;
}

#btn_logout {
    min-width: 8;
    height: 1;
    background: transparent;
    color: #888888;
    border: none;
    padding: 0;
}

#btn_logout:hover {
    color: #ff5555;
}

/* Main Workspace Pane */
#main_pane {
    width: 1fr;
    height: 100%;
    background: #0d0d0d;
}

#header_bar {
    height: 3;
    background: #0d0d0d;
    border-bottom: solid #1a1a1a;
    align: left middle;
    padding: 0 2;
}

#btn_toggle_sidebar {
    min-width: 4;
    height: 1;
    background: transparent;
    color: #ffffff;
    border: none;
    padding: 0;
    margin-right: 2;
}

#btn_toggle_sidebar:hover {
    color: #ffb86c;
}

#header_title {
    color: #888888;
    content-align: left middle;
}

#chat_area {
    width: 100%;
    height: 1fr;
}

#retro_banner {
    width: 100%;
    height: auto;
    text-align: center;
    color: #888888;
    background: transparent;
    padding: 2 0;
}

#retro_banner.-hidden {
    display: none;
}

#chat_history {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    overflow-y: scroll;
}

/* Message Cards */
.msg_card {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    padding: 0 1;
    background: transparent;
    border: none;
}

.msg_user {
    padding-bottom: 1;
}

.msg_agent {
    border-bottom: solid #1a1a1a;
    padding-bottom: 2;
}

.msg_plan {
    border-left: dashed #ffb86c;
    background: #121212;
    padding: 1 2;
    margin-bottom: 2;
}

.msg_tool_panel {
    background: transparent;
    border: none;
    padding: 0;
}

/* Input Section */
#input_container {
    height: auto;
    padding: 1 2 2 2;
    background: #0d0d0d;
}

#prompt_input {
    background: #121212;
    color: #ffffff;
    border: solid #262626;
    padding: 0 2;
    height: 3;
}

#prompt_input:focus {
    border: solid #ffb86c;
}

#input_status_bar {
    height: 3;
    layout: horizontal;
    padding: 0 1;
}

#token_counter {
    width: 1fr;
    color: #666666;
    content-align: left middle;
}

#spinner_lbl {
    width: auto;
    color: #ffb86c;
    content-align: center middle;
}

#model_selection_lbl {
    background: transparent;
    border: none;
    color: #888888;
    content-align: right middle;
    margin-right: 2;
    min-width: 18;
    height: 1;
    padding: 0;
}

#model_selection_lbl:hover {
    color: #ffb86c;
}

#btn_send {
    min-width: 4;
    height: 1;
    background: transparent;
    color: #888888;
    border: none;
    padding: 0;
}

#btn_send:hover {
    color: #ffb86c;
}

/* Modal Dialogs */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#modal_dialog {
    layout: grid;
    grid-size: 1 3;
    grid-rows: 3 10 3;
    width: 60;
    height: 20;
    background: #1a1a1a;
    border: solid #ffb86c;
    padding: 1 2;
}

#modal_title {
    text-align: center;
    text-style: bold;
    color: #ffb86c;
}

#model_list {
    background: #121212;
    border: solid #262626;
}

#confirm_dialog {
    layout: grid;
    grid-size: 1 4;
    grid-rows: 3 12 2 4;
    width: 70;
    height: 26;
    background: #1a1a1a;
    border: solid #ffb86c;
    padding: 1 2;
}

#confirm_title {
    text-align: left;
    text-style: bold;
    color: #ffb86c;
}

#confirm_preview_text {
    background: #121212;
    border: solid #262626;
    padding: 1 2;
}

#confirm_preview_rich {
    background: transparent;
    padding: 0;
}

#confirm_footer {
    color: #888888;
}

#confirm_buttons {
    align: right middle;
    height: auto;
}

#confirm_buttons Button {
    margin-left: 2;
}

/* ─── Thinking Block (collapsible reasoning dropdown) ─────────────────────── */

.thinking_block {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    background: transparent;
}

.thinking_block Collapsible {
    background: #111111;
    border: solid #1e1e2e;
    border-left: solid #6272a4;
    padding: 0 1;
    margin: 0 1;
}

.thinking_block CollapsibleTitle {
    color: #6272a4;
    text-style: italic;
    padding: 0 1;
    height: 1;
}

.thinking_block CollapsibleTitle:hover {
    color: #bd93f9;
    background: #1a1a2e;
}

.thinking_body {
    color: #6272a4;
    padding: 0 2 1 2;
    height: auto;
}
